{
  "name": "4yos",
  "productName": "4YOS",
  "version": "0.1.14",
  "private": true,
  "description": "Personal AI operating system for one owner on one Windows laptop",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "web:build": "node scripts/build-web.mjs",
    "web:preview": "node scripts/preview-web.mjs",
    "programmes": "node scripts/programmes.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/unit/*.test.ts && node test/mcp/run.mjs && node scripts/programmes.mjs --check",
    "e2e": "npm run build && node test/e2e/entry.mjs && node test/e2e/run.mjs && node test/e2e/proof.mjs && node test/e2e/course.mjs && node test/e2e/format.mjs",
    "package:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/grandstander": "^5.3.0",
    "@observablehq/plot": "^0.6.18",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "codemirror": "^6.0.2",
    "ical.js": "2.2.1",
    "jsxgraph": "^1.14.2",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "pyodide": "^314.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
